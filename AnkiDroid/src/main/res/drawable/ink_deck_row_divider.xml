<?xml version="1.0" encoding="utf-8"?>
<!-- ink: hairline under each deck row. Drawn as the row's foreground: DeckAdapter sets the background in code. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom|fill_horizontal" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
