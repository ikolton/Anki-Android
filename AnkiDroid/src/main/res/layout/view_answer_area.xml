<?xml version="1.0" encoding="utf-8"?>
<!-- ink: desktop-style outlined buttons, answer buttons in a 2×2 grid -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/show_answer_button"
        style="@style/Ink.ShowAnswerButton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:text="@string/show_answer" />

    <GridLayout
        android:id="@+id/answer_buttons_layout"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:columnCount="2"
        android:useDefaultMargins="false"
        android:visibility="invisible"
        >

        <com.ichi2.anki.ui.windows.reviewer.AnswerButton
            android:id="@+id/again_button"
            style="@style/Ink.AnswerButton"
            app:easeName="@string/ink_ease_again" />

        <com.ichi2.anki.ui.windows.reviewer.AnswerButton
            android:id="@+id/hard_button"
            style="@style/Ink.AnswerButton"
            app:easeName="@string/ink_ease_hard" />

        <com.ichi2.anki.ui.windows.reviewer.AnswerButton
            android:id="@+id/good_button"
            style="@style/Ink.AnswerButton.Primary"
            app:easeName="@string/ink_ease_good" />

        <com.ichi2.anki.ui.windows.reviewer.AnswerButton
            android:id="@+id/easy_button"
            style="@style/Ink.AnswerButton"
            app:easeName="@string/ink_ease_easy" />
    </GridLayout>
</merge>
